# Postgres connection string from your free-tier host (Supabase or Neon)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Free Google Gemini API key for LLM-backed extraction, scoring, and suggestion
# generation - get one at https://aistudio.google.com/apikey (no credit card
# required for the free tier)
GEMINI_API_KEY=...

# Optional: override the model (default is a pinned gemini-3.5-flash-lite,
# not the "-latest" alias - see the comment in src/llm/client.ts for why)
# GEMINI_MODEL=gemini-3.5-flash-lite
